# ── Обязательные (bootstrap — только через env, в базе жить не могут) ──────
# Локальная разработка: postgresql://<юзер>@localhost:5432/geleoteka
# Прод: задаётся в переменных приложения Timeweb, НЕ здесь.
DATABASE_URL="postgresql://user:password@localhost:5432/geleoteka"

# Подпись JWT-сессий. Для dev — любая строка 32+ символов (у каждой машины своя).
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# Абсолютный URL сайта (вшивается в клиентский бандл при сборке).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Опциональные env-фолбэки ────────────────────────────────────────────────
# Интеграционные ключи (Resend, SMSC и будущие) задаются в АДМИНКЕ:
# /admin/settings/integrations → таблица Setting. Порядок разрешения:
# строка в БД → переменная окружения → null (см. lib/settings.ts).
# Env-переменные ниже нужны только как fallback, когда в БД значения нет.

# ── Email (отправка / transport) ─────────────────────────────────────────────
# Провайдер-нейтральная отправка. Дефолт — generic SMTP (nodemailer); Resend —
# опциональный legacy-адаптер (EMAIL_TRANSPORT=resend). Автопереключения между
# провайдерами НЕТ (риск двойной отправки). NON-SECRET (transport/host/port/
# secure/user/from/reply-to) можно задать в АДМИНКЕ или как env-fallback ниже.
# ПАРОЛЬ SMTP — СЕКРЕТ, ТОЛЬКО env, НЕ в таблице Setting.
# EMAIL_TRANSPORT=smtp                           # smtp (по умолчанию) | resend
# EMAIL_FROM="Geleoteka <sales@geleoteka.ru>"     # единый видимый From
# EMAIL_REPLY_TO=sales@geleoteka.ru               # реальный ящик для ответов → CRM
# SMTP_HOST=smtp.timeweb.ru                      # для другого тенанта — свой сервер
# SMTP_PORT=465                                  # 465 implicit TLS | 587 STARTTLS
# SMTP_SECURE=true                               # true для 465, false для 587
# SMTP_USER=sales@geleoteka.ru                    # логин = полный адрес ящика
# SMTP_PASSWORD=                                 # СЕКРЕТ: пароль сервисного ящика (только env)

# Email (Resend — LEGACY, опциональный): работает только при EMAIL_TRANSPORT=resend.
# Без ключа resend-отправка работает в mock-режиме (лог в консоль).
# RESEND_API_KEY=
# RESEND_FROM="Geleoteka <sales@geleoteka.ru>"   # legacy-фолбэк для EMAIL_FROM
# RESEND_FROM_FALLBACK="onboarding@resend.dev"

# S+ (интеграция каталога) — выключена, пока не заданы обе переменные.
# SPLUS_API_URL=
# SPLUS_API_KEY=

# ── Email (Timeweb IMAP sync — mail-sync воркер) ─────────────────────────────
# NON-SECRET настройки (host/port/источники/флаг) можно задать в АДМИНКЕ или тут
# как env-fallback. СЕКРЕТ — только пароли ящиков — живёт ИСКЛЮЧИТЕЛЬНО в env
# ниже, НЕ в таблице Setting и НЕ в клиентском бандле.
#
# MAIL_SYNC_ENABLED=false                       # главный рубильник воркера
# TIMEWEB_IMAP_HOST=imap.timeweb.ru             # только IMAPS/TLS
# TIMEWEB_IMAP_PORT=993
# Источники (JSON): INBOUND — прямой опрос ящика; OUTBOUND_ARCHIVE — архив «Контроля исходящих».
# MAIL_SYNC_SOURCES=[{"mailbox":"sales@geleoteka.ru","folder":"INBOX","role":"INBOUND"},{"mailbox":"crm-archive@geleoteka.ru","folder":"INBOX","role":"OUTBOUND_ARCHIVE"}]
#
# Учётные данные IMAP (логин = полный адрес ящика). ПАРОЛИ — СЕКРЕТ, только env:
#   Один ящик:   TIMEWEB_IMAP_USER + TIMEWEB_IMAP_PASSWORD (user должен совпасть с mailbox источника)
#   Несколько:   TIMEWEB_IMAP_PASSWORD_<SLUG>, где SLUG = адрес в верхнем регистре, не-буквенно-цифровые → «_»
#                напр. sales@geleoteka.ru → TIMEWEB_IMAP_PASSWORD_INFO_GELEOTEKA_RU
# TIMEWEB_IMAP_USER=crm-archive@geleoteka.ru
# TIMEWEB_IMAP_PASSWORD=
# TIMEWEB_IMAP_PASSWORD_INFO_GELEOTEKA_RU=
# TIMEWEB_IMAP_PASSWORD_CRM_ARCHIVE_GELEOTEKA_RU=
#
# Тюнинг воркера (опционально):
# MAIL_SYNC_INTERVAL_MS=60000                   # период прохода по источникам
# MAIL_SYNC_BATCH_SIZE=50                       # UID за один проход на источник
# MAIL_SYNC_LEASE_MS=120000                     # окно аренды источника (мьютекс реплик)
#
# Fallback-эндпоинт (только если отдельный воркер недоступен на хостинге):
# внешний планировщик шлёт POST с заголовком Authorization: Bearer <секрет>.
# MAIL_SYNC_CRON_SECRET=
